{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sync:legal && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/qpdf",
      "resources/pdfium-runtime",
      "resources/legal"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "allowDowngrades": true,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "349046AE-FB14-5C8D-A408-FF3B0B047315"
      }
    }
  },
  "productName": "Rocktier PDF",
  "version": "1.0.20",
  "identifier": "Rocktier.RocktierPDF",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rocktier PDF",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://rocktier.com"
    },
    "withGlobalTauri": false
  },
  "mainBinaryName": "RocktierPDF"
}
